{{- $index := slice -}}
{{- /* The artifact gallery is a companion, not blog content: keep it out of site search */ -}}
{{- range where .Site.RegularPages.ByDate.Reverse "Section" "ne" "artifacts" -}}
    {{- $page := . -}}
    {{- $imageURL := "" -}}
    {{- with .Params.featuredimage -}}
        {{- if strings.HasPrefix . "http" -}}
            {{- $imageURL = . -}}
        {{- else -}}
            {{- with $page.Resources.GetMatch . -}}
                {{- $imageURL = .Permalink -}}
            {{- else -}}
                {{- $imageURL = . | absURL -}}
            {{- end -}}
        {{- end -}}
    {{- end -}}
    {{- $entry := dict
        "date" (.Date.Format "2006-01-02T15:04:05Z07:00")
        "externalUrl" .Params.externalUrl
        "featured_image" $imageURL
        "permalink" .Permalink
        "summary" (partial "function/summary.html" .)
        "title" .Title
        "url" .Permalink
    -}}
    {{- $index = $index | append $entry -}}
{{- end -}}
{{- $index | jsonify (dict "indent" "  ") | safeJS -}}
